// Run ▸ a notebook cell (ADR-0043).
//
// The same collapsed-rather-than-conditional shape as `ResultsPanel` and
// `OrganizePanel`, for the same reason: an element inside an `if` cannot be
// referred to from outside it, and keeping every bottom panel on one rule
// means one fewer difference to remember.
//
// **`stdout` and `stderr` are two properties, not one string.** `bp-execution`
// captures them separately and says why -- "a caller may want to tell them
// apart, for instance to show one in a different colour" -- and this is that
// caller. Merging them here would throw away the distinction the crate went
// to the trouble of keeping, and a reader checking whether an example still
// works wants to know which stream said what.

import { MenuLabel } from "menu.slint";
import { Palette } from "types.slint";

export component RunPanel inherits Rectangle {
    in property <bool> open;
    /// Which cell this is, and how it ended. Written by Rust, because only
    /// Rust knows the exit code, the duration and whether a cap or a deadline
    /// cut it short.
    in property <string> summary;
    in property <string> output;
    in property <string> errors;

    callback closed();

    height: root.open ? 200px : 0px;
    visible: root.open;
    background: Palette.panel;

    VerticalLayout {
        padding: 6px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.summary;
                color: Palette.ink-dim;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            MenuLabel {
                label: "×";
                clicked => {
                    root.closed();
                }
            }
        }

        Flickable {
            // Pinned to the visible width for the same reason `MenuPopup`'s
            // viewport is: left to size itself to the content, one long line
            // of output would lay every other one out past the right edge,
            // where a Flickable clips it.
            viewport-width: self.width;
            viewport-height: streams.preferred-height;

            streams := VerticalLayout {
                alignment: start;
                spacing: 2px;

                Text {
                    text: root.output;
                    color: Palette.ink;
                    font-family: "Consolas";
                    font-size: 12px;
                    wrap: word-wrap;
                }
                // In the accent, like every other thing in this shell that a
                // reader should not be able to miss.
                Text {
                    text: root.errors;
                    color: Palette.accent;
                    font-family: "Consolas";
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
