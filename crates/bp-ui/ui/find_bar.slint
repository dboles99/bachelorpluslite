// The find and replace bar.
//
// Collapsed rather than conditional: an element inside a Slint `if` is out of
// scope for anything outside it, and Ctrl+F has to be able to put the caret in
// the box it has just opened. `open` therefore drives height and visibility,
// and the query box always exists.
//
// That is also why `focus-query` is a function here rather than the window
// reaching in: the input is this component's business, and a parent cannot
// name an element inside a child.

import { MenuLabel } from "menu.slint";
import { Palette } from "types.slint";

// A search option: on or off, and it has to look it.
//
// `MenuLabel` is the shell's clickable-label shape and this is deliberately
// not one, because `MenuLabel` has no state to show. An option whose setting
// the user cannot see is worse than no option at all -- a case-sensitive find
// that silently stays on explains "no matches" for a search that should have
// found something, and there would be nothing on screen to say why.
component FindToggle inherits Rectangle {
    in property <string> label;
    /// What the option is called aloud. "Aa" and ".*" are pictures of the
    /// option, and read out they are noise.
    in property <string> name;
    in property <bool> active;
    callback toggled();

    accessible-role: checkbox;
    accessible-label: root.name;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-action-default => {
        root.toggled();
    }

    // 26px is `MenuLabel`'s height, which is what the rest of this bar is
    // built from and what is known to sit correctly in its 26px content area.
    height: 26px;
    width: txt.preferred-width + 16px;
    // Filled when on, outlined when off: the difference has to survive all
    // four themes, so it is a background swap rather than a colour shift.
    background: root.active ? Palette.accent : (ta.has-hover ? Palette.edge : transparent);
    border-color: Palette.edge;
    border-width: 1px;

    txt := Text {
        text: root.label;
        accessible-role: none;
        color: Palette.ink;
        font-size: 12px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    ta := TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

export component FindBar inherits Rectangle {
    in property <bool> open;
    in-out property <string> find-query;
    in-out property <string> replace-query;
    /// The three options, owned by the window so Rust can read them on every
    /// search. Flipping one re-runs the search through `find-changed`, because
    /// a toggle that leaves stale matches on screen is a toggle that appears
    /// not to work.
    in-out property <bool> case-sensitive;
    in-out property <bool> whole-word;
    in-out property <bool> regex;
    /// "3 of 12", "no matches", or a bad-pattern message.
    in property <string> find-status;

    callback find-changed();
    callback find-next();
    callback find-previous();
    callback replace-all();
    callback search-folder();
    /// The × was clicked. The window owns what "closed" means -- clearing the
    /// flag and deciding where the caret goes -- because it owns both editors.
    callback closed();

    /// Put the caret in the query box and select what is there, so that Ctrl+F
    /// on an open bar replaces the previous query rather than appending to it.
    public function focus-query() {
        find-input.focus();
        find-input.select-all();
    }

    height: root.open ? 34px : 0px;
    visible: root.open;
    background: Palette.shell;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 8px;

        Text {
            text: "Find";
            color: Palette.ink-dim;
            font-size: 12px;
            vertical-alignment: center;
        }

        Rectangle {
            width: 220px;
            background: Palette.panel;
            border-color: Palette.edge;
            border-width: 1px;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                find-input := TextInput {
                    text <=> root.find-query;
                    accessible-label: "Find";
                    color: Palette.ink;
                    selection-background-color: Palette.accent;
                    font-size: 13px;
                    single-line: true;
                    vertical-alignment: center;
                    edited => {
                        root.find-changed();
                    }
                    accepted => {
                        root.find-next();
                    }
                }
            }
        }

        // Beside the box they modify, and before the arrows, so that reading
        // left to right gives the query, then how it is interpreted, then how
        // to move through what it found.
        FindToggle {
            label: "Aa";
            name: "Match case";
            active: root.case-sensitive;
            toggled => {
                root.case-sensitive = !root.case-sensitive;
                root.find-changed();
            }
        }
        FindToggle {
            label: "Word";
            name: "Whole word";
            active: root.whole-word;
            toggled => {
                root.whole-word = !root.whole-word;
                root.find-changed();
            }
        }
        FindToggle {
            label: ".*";
            name: "Regular expression";
            active: root.regex;
            toggled => {
                root.regex = !root.regex;
                root.find-changed();
            }
        }

        MenuLabel {
            label: "◂";
            name: "Previous match";
            clicked => {
                root.find-previous();
            }
        }
        MenuLabel {
            label: "▸";
            name: "Next match";
            clicked => {
                root.find-next();
            }
        }

        Text {
            text: root.find-status;
            color: Palette.ink-dim;
            font-size: 12px;
            vertical-alignment: center;
            width: 110px;
        }

        Text {
            text: "Replace";
            color: Palette.ink-dim;
            font-size: 12px;
            vertical-alignment: center;
        }

        Rectangle {
            width: 200px;
            background: Palette.panel;
            border-color: Palette.edge;
            border-width: 1px;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                TextInput {
                    text <=> root.replace-query;
                    accessible-label: "Replace with";
                    color: Palette.ink;
                    selection-background-color: Palette.accent;
                    font-size: 13px;
                    single-line: true;
                    vertical-alignment: center;
                }
            }
        }

        MenuLabel {
            label: "Replace All";
            clicked => {
                root.replace-all();
            }
        }

        MenuLabel {
            label: "In Folder...";
            name: "Search in folder";
            clicked => {
                root.search-folder();
            }
        }

        Rectangle { horizontal-stretch: 1; }

        MenuLabel {
            label: "×";
            name: "Close find bar";
            clicked => {
                root.closed();
            }
        }
    }
}
