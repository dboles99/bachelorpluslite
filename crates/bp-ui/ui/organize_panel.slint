// Organize ▸ Related Notes (ADR-0037).
//
// A near-copy of `ResultsPanel`: collapsed rather than conditional, for the
// same reason -- an element inside an `if` cannot be referred to from outside
// it, and keeping every bottom panel on the same rule means one fewer
// difference to remember. `SearchHit` is reused rather than a dedicated
// struct: a related note is a label, a detail line and an id to click, which
// is exactly that struct's shape, and a second struct with the same three
// fields would be a second name for one idea.

import { MenuLabel } from "menu.slint";
import { SearchHit, Palette } from "types.slint";

export component OrganizePanel inherits Rectangle {
    in property <bool> open;
    in property <[SearchHit]> hits;
    in property <string> summary;

    /// The index carried by the hit, not its position in the list -- the list
    /// is a view of what Rust found, and only Rust can turn a hit into a
    /// document.
    callback open-hit(int);
    callback closed();

    height: root.open ? 180px : 0px;
    visible: root.open;
    background: Palette.panel;

    VerticalLayout {
        padding: 6px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.summary;
                color: Palette.ink-dim;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            MenuLabel {
                label: "×";
                clicked => {
                    root.closed();
                }
            }
        }

        Flickable {
            viewport-height: hit-list.preferred-height;

            hit-list := VerticalLayout {
                alignment: start;

                for hit in root.hits: Rectangle {
                    height: 22px;
                    background: hit-area.has-hover ? Palette.edge : transparent;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 10px;

                        Text {
                            text: hit.label;
                            color: Palette.accent;
                            font-size: 12px;
                            vertical-alignment: center;
                            width: 260px;
                            overflow: elide;
                        }
                        Text {
                            text: hit.detail;
                            color: Palette.ink-dim;
                            font-family: "Consolas";
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }

                    hit-area := TouchArea {
                        clicked => {
                            root.open-hit(hit.index);
                        }
                    }
                }
            }
        }
    }
}
