// The status bar (specs.md section 3).
//
// Two rows: what the document is, and where it is. The second row doubles as
// the error line, because an error about the open document belongs next to the
// document's path rather than in a dialog the user has to dismiss.

import { Palette } from "types.slint";

// A readout after a separator. The separator is drawn and not said: read
// aloud, "│ UTF-8" is "vertical line UTF-8", five times along one bar.
component StatusText inherits Text {
    in property <string> value;
    text: "│ " + root.value;
    accessible-label: root.value;
    color: Palette.ink-dim;
    font-size: 12px;
    vertical-alignment: center;
}

export component StatusBar inherits Rectangle {
    in property <string> save-state;
    in property <bool> is-dirty;
    in property <string> format-label;
    in property <string> encoding-label;
    in property <string> line-ending-label;
    in property <string> cursor-label;
    /// Overtype mode. Shown only while it is on, like the security label:
    /// insert is the ordinary case, and a mode that changes what every
    /// keystroke does is the one thing a reader must be able to see.
    in property <bool> overwrite;
    in property <string> theme-name;
    /// The active document's security profile, or empty under the default.
    ///
    /// Shown only when it is not Standard: a permanent "Standard" would be
    /// noise on every document, and the whole value of the readout is that
    /// something *unusual* is in force.
    in property <string> security-label;
    /// "Large file" and its size, or empty.
    ///
    /// Empty for an ordinary document, on the same argument as the security
    /// label above: a status bar that labels the ordinary case teaches people
    /// to ignore it. `bp_buffer::SizeClass::label` makes exactly that point
    /// and returns "" for `Normal`.
    in property <string> location;
    in property <string> error-message;

    callback cycle-theme();

    height: 44px;
    background: Palette.panel;

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 2px;

        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            Text {
                text: root.save-state;
                // Dirty is the state worth noticing, so it gets
                // the accent; a clean save is unremarkable.
                color: root.is-dirty ? Palette.accent : Palette.ink-dim;
                font-size: 12px;
                vertical-alignment: center;
            }
            StatusText { value: root.format-label; }
            StatusText { value: root.encoding-label; }
            StatusText { value: root.line-ending-label; }
            StatusText { value: root.cursor-label; }
            if root.overwrite: Text {
                text: "│ Overtype";
                accessible-label: "Overtype";
                color: Palette.accent;
                font-size: 12px;
                vertical-alignment: center;
            }
            // In the accent, like the theme name and the dirty marker: it
            // only appears when it has something to say, and when it does it
            // is a statement about where this document's data may go.
            if root.security-label != "": Text {
                text: "│ " + root.security-label;
                accessible-label: root.security-label;
                color: Palette.accent;
                font-size: 12px;
                vertical-alignment: center;
            }

            Rectangle {
                width: theme-label.preferred-width + 16px;
                background: theme-area.has-hover ? Palette.edge : transparent;
                // It looks like a readout and is a button: a click moves to
                // the next theme. Saying so is the only way a reader finds out.
                accessible-role: button;
                accessible-label: "Theme: " + root.theme-name + ". Next theme";
                accessible-action-default => {
                    root.cycle-theme();
                }
                theme-label := Text {
                    text: "│ " + root.theme-name;
                    accessible-role: none;
                    color: Palette.accent;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                theme-area := TouchArea {
                    clicked => {
                        root.cycle-theme();
                    }
                }
            }
        }

        Text {
            text: root.error-message == "" ? root.location : root.error-message;
            color: root.error-message == "" ? Palette.ink-dim : Palette.accent;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}
