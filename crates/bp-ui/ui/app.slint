// BachelorPad+ application shell.
//
// This file deliberately contains no colour literals. Every colour comes from
// the `Palette` global, which Rust fills from `bp-theme` -- ADR-0009 requires
// themes to be data, and a hex code in here would be a theme that a user
// could never override.

export struct TabInfo {
    id: int,
    label: string,
    dirty: bool,
    active: bool,
}

// One row in a menu. `action` is dispatched by number: ids below 100 are
// handled in Rust, 100 and above are editor functions Slint owns (undo, cut,
// paste and friends live on TextInput, not in our state).
//
// `enabled: false` renders the row greyed and inert. Menus for subsystems that
// do not exist yet list their contents that way rather than being labels that
// swallow a click -- a menu that does nothing when clicked reads as broken,
// while a menu of greyed items reads as "not yet", which is the truth.
export struct MenuItem {
    label: string,
    shortcut: string,
    action: int,
    enabled: bool,
    separator-after: bool,
}

/// One row in the cross-file search results.
export struct SearchHit {
    label: string,
    detail: string,
    index: int,
}

/// One visible line of the document, as `EditorSurface` draws it.
///
/// The gutter number arrives already formatted: which lines are on screen is
/// Rust's decision, and having Slint recompute it from an index would be a
/// second implementation of the same arithmetic.
export struct EditorRow {
    number: string,
    text: string,
}

/// One line's worth of selection highlight, in **visual** columns -- after
/// tabs have expanded, which is the only measure that lines up with the text.
export struct SelectionBox {
    row: int,
    start: int,
    end: int,
}

export global Palette {
    in property <color> shell;
    in property <color> panel;
    in property <color> edge;
    in property <color> ink;
    in property <color> ink-dim;
    in property <color> accent;
}

component MenuLabel inherits Rectangle {
    in property <string> label;
    in property <bool> open;
    callback clicked();
    height: 26px;
    width: txt.preferred-width + 22px;
    background: root.open || ta.has-hover ? Palette.edge : transparent;

    txt := Text {
        text: root.label;
        color: Palette.ink;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component MenuRow inherits Rectangle {
    in property <MenuItem> item;
    callback chosen(int);
    height: 28px;
    background: root.item.enabled && ta.has-hover ? Palette.edge : Palette.panel;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 24px;

        Text {
            text: root.item.label;
            // Greyed when inert, so "not implemented" is visible rather than
            // discovered by clicking.
            color: root.item.enabled ? Palette.ink : Palette.ink-dim;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Text {
            text: root.item.shortcut;
            color: Palette.ink-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => {
            if (root.item.enabled) {
                root.chosen(root.item.action);
            }
        }
    }
}

component MenuPopup inherits PopupWindow {
    in property <[MenuItem]> items;
    in property <length> menu-width: 280px;
    callback chosen(int);

    width: root.menu-width;
    height: content.preferred-height;

    Rectangle {
        background: Palette.panel;
        border-color: Palette.edge;
        border-width: 1px;

        content := VerticalLayout {
            padding: 4px;
            for item in root.items: VerticalLayout {
                MenuRow {
                    item: item;
                    chosen(action) => {
                        root.chosen(action);
                    }
                }

                if item.separator-after: Rectangle {
                    height: 5px;
                    Rectangle {
                        height: 1px;
                        y: 2px;
                        background: Palette.edge;
                    }
                }
            }
        }
    }
}

// The custom editor surface.
//
// Slint's `TextInput` owns its own text, caret and undo stack, which is the
// single fact blocking three separate things: the rope in `bp-buffer` cannot
// be the storage, `bp-editor`'s undo cannot be the authority, and the status
// bar cannot show Ln/Col. This component exists to own none of those either
// -- it draws what Rust hands it and reports what the user did. Every
// decision lives in `bp-editor`, which is tested without a window.
//
// Only the visible rows are ever built, so a 100,000-line document costs the
// same to draw as a ten-line one.
component EditorSurface inherits Rectangle {
    in property <[EditorRow]> rows;
    in property <[SelectionBox]> selection;
    /// Viewport row of the caret, or -1 when it is scrolled out of sight.
    in property <int> caret-row: -1;
    in property <int> caret-column;
    in property <bool> show-gutter: true;
    in property <length> font-size: 14px;
    in property <length> line-height: 18px;

    /// text, control, shift, alt. Returns whether the editor claimed it --
    /// anything it does not claim must bubble up, or Ctrl+S stops saving.
    callback key(string, bool, bool, bool) -> bool;
    /// row, visual column, extend-selection.
    callback pressed(int, int, bool);
    callback dragged(int, int);
    /// Lines to scroll; positive is toward the end of the document.
    callback scrolled(int);
    /// How many rows now fit.
    callback resized(int);

    // The character advance is measured, not assumed. A hard-coded ratio
    // drifts the caret one fraction of a pixel further from its character
    // with every column, which is invisible until someone types a long line
    // and then unusable. Twenty characters so the division dilutes rounding;
    // the fallback only applies before the first layout pass, when
    // `preferred-width` is still zero.
    probe := Text {
        text: "MMMMMMMMMMMMMMMMMMMM";
        font-family: "Consolas";
        font-size: root.font-size;
        opacity: 0;
    }
    property <length> advance: probe.preferred-width > 0
        ? probe.preferred-width / 20
        : root.font-size * 0.6;

    property <length> pad: 10px;
    property <length> gutter-width: root.show-gutter ? 46px : 0px;
    property <length> text-left: root.pad + root.gutter-width;

    property <int> fitting-rows: max(1, floor((self.height - 2 * root.pad) / root.line-height));
    changed fitting-rows => {
        root.resized(self.fitting-rows);
    }

    function row-at(y: length) -> int {
        return max(0, floor((y - root.pad) / root.line-height));
    }
    // Rounded, not floored: clicking the right half of a character puts the
    // caret after it, which is what every editor does and what makes
    // click-to-place feel accurate rather than one character left.
    function column-at(x: length) -> int {
        return max(0, round((x - root.text-left) / root.advance));
    }

    background: Palette.panel;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if (root.key(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt)) {
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    // Selection first, so the text draws over it.
    for box in root.selection: Rectangle {
        x: root.text-left + box.start * root.advance;
        y: root.pad + box.row * root.line-height;
        width: (box.end - box.start) * root.advance;
        height: root.line-height;
        background: Palette.accent;
    }

    for row[i] in root.rows: Text {
        x: root.text-left;
        y: root.pad + i * root.line-height;
        height: root.line-height;
        text: row.text;
        color: Palette.ink;
        font-family: "Consolas";
        font-size: root.font-size;
        vertical-alignment: center;
    }

    if root.show-gutter: Rectangle {
        for row[i] in root.rows: Text {
            x: root.pad;
            y: root.pad + i * root.line-height;
            width: root.gutter-width - 10px;
            height: root.line-height;
            text: row.number;
            color: Palette.ink-dim;
            font-family: "Consolas";
            font-size: root.font-size;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    // Hidden when the surface is not focused, so it is clear which of the
    // find box and the document a keystroke would reach.
    Rectangle {
        visible: root.caret-row >= 0 && keys.has-focus;
        x: root.text-left + root.caret-column * root.advance;
        y: root.pad + root.caret-row * root.line-height;
        width: 2px;
        height: root.line-height;
        background: Palette.ink;
    }

    // Last, so it sits above the drawing and receives the pointer.
    touch := TouchArea {
        mouse-cursor: text;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                keys.focus();
                root.pressed(root.row-at(self.mouse-y), root.column-at(self.mouse-x), event.modifiers.shift);
            }
        }
        moved => {
            if (self.pressed) {
                root.dragged(root.row-at(self.mouse-y), root.column-at(self.mouse-x));
            }
        }
        scroll-event(event) => {
            // A wheel notch is reported in pixels; a line is the unit the
            // document is virtualised in.
            root.scrolled(-round(event.delta-y / root.line-height));
            return EventResult.accept;
        }
    }
}

component Tab inherits Rectangle {
    in property <string> label;
    in property <bool> dirty;
    in property <bool> active;
    callback selected();
    callback closed();

    height: 30px;
    width: 190px;
    background: root.active ? Palette.panel : Palette.shell;
    border-color: Palette.edge;
    border-width: 1px;

    select-area := TouchArea {
        clicked => {
            root.selected();
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 6px;

        // A dot rather than the usual asterisk: it matches the status bar's
        // unsaved marker, so one symbol means "not on disk" everywhere.
        Text {
            text: root.dirty ? "●" : "";
            color: Palette.accent;
            font-size: 13px;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: root.active ? Palette.ink : Palette.ink-dim;
            font-size: 13px;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Rectangle {
            width: 18px;
            background: close-area.has-hover ? Palette.edge : transparent;
            Text {
                text: "×";
                color: Palette.ink-dim;
                font-size: 15px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            close-area := TouchArea {
                clicked => {
                    root.closed();
                }
            }
        }
    }
}

component StatusText inherits Text {
    color: Palette.ink-dim;
    font-size: 12px;
    vertical-alignment: center;
}

export component AppWindow inherits Window {
    title: "BachelorPad+";
    preferred-width: 1000px;
    preferred-height: 680px;
    background: Palette.shell;

    in-out property <string> doc-text;
    in property <[TabInfo]> tabs;
    in property <string> gutter;
    in property <string> save-state;
    in property <bool> is-dirty;
    in property <string> location;
    in property <string> format-label;
    in property <string> encoding-label;
    in property <string> line-ending-label;
    in property <string> cursor-label;
    in property <string> theme-name;
    in property <string> error-message;

    // View toggles, driven from the View menu.
    in property <bool> show-gutter: true;
    in property <bool> wrap-text: false;

    // Menu contents, built in Rust so that enabled state can depend on
    // application state (Save All only when something is unsaved, and so on).
    in property <[MenuItem]> file-items;
    in property <[MenuItem]> edit-items;
    in property <[MenuItem]> view-items;
    in property <[MenuItem]> insert-items;
    in property <[MenuItem]> format-items;
    in property <[MenuItem]> data-items;
    in property <[MenuItem]> note-items;
    in property <[MenuItem]> notebook-items;
    in property <[MenuItem]> organize-items;
    in property <[MenuItem]> research-items;
    in property <[MenuItem]> run-items;
    in property <[MenuItem]> security-items;
    in property <[MenuItem]> tools-items;
    in property <[MenuItem]> help-items;

    callback new-document();
    callback open-document();
    callback save-document();
    callback save-as-document();
    callback select-tab(int);
    callback close-tab(int);
    callback close-active-tab();
    callback cycle-theme();
    callback text-edited(string);
    /// Menu actions below 100. Ids from 100 up never reach Rust.
    callback menu-action(int);

    // --- custom editor surface -----------------------------------------
    // Opt-in until it reaches parity with the widget it replaces: word wrap
    // and input-method composition both still belong to `TextInput`. The
    // rope is the storage either way; only the drawing differs.
    in property <bool> use-editor-view;
    in property <[EditorRow]> editor-rows;
    in property <[SelectionBox]> editor-selection;
    in property <int> caret-row: -1;
    in property <int> caret-column;

    callback editor-key(string, bool, bool, bool) -> bool;
    callback editor-pressed(int, int, bool);
    callback editor-dragged(int, int);
    callback editor-scrolled(int);
    callback editor-resized(int);

    // --- find and replace ---------------------------------------------
    in-out property <bool> find-open;
    in-out property <string> find-query;
    in-out property <string> replace-query;
    /// "3 of 12", "no matches", or a bad-pattern message.
    in property <string> find-status;

    callback find-changed();
    callback find-next();
    callback find-previous();
    callback replace-all();

    // Cross-file search results.
    in property <[SearchHit]> search-hits;
    // in-out: Rust opens it after a search, the close button shuts it.
    in-out property <bool> results-open;
    in property <string> results-summary;
    callback search-folder();
    callback open-hit(int);

    /// Select a range in the editor. Called from Rust once it has worked out
    /// where the next match is -- `set-selection-offsets` is a function on
    /// the widget, so only Slint can invoke it.
    public function select-range(start: int, end: int) {
        if (root.use-editor-view) {
            // Rust has already moved its own caret; there is nothing here to
            // tell. Just take the focus back from the find box.
            surface.focus();
            return;
        }
        editor.set-selection-offsets(start, end);
        editor.focus();
    }

    /// Paste whatever the OS clipboard holds at the caret.
    ///
    /// Rust puts the chosen history entry on the clipboard first. Under
    /// `TextInput` that is the only way to insert at the caret, because the
    /// caret is not readable; under the custom surface it is a courtesy, and
    /// the insertion has already happened.
    public function paste-from-clipboard() {
        if (root.use-editor-view) {
            // We own the caret, so Rust inserted at it directly.
            surface.focus();
            return;
        }
        editor.focus();
        editor.paste();
    }

    public function focus-find() {
        root.find-open = true;
        find-input.focus();
        find-input.select-all();
    }

    /// Put the caret back in whichever editor is in use.
    public function focus-editor() {
        if (root.use-editor-view) {
            surface.focus();
        } else {
            editor.focus();
        }
    }

    // Typing goes to the editor unless the user clicks elsewhere.
    forward-focus: editor;

    // Editor-local menu actions.
    //
    // Under `TextInput` these call functions on the widget, because Slint
    // owns its text, selection and undo stack and Rust cannot reach them.
    // Under the custom surface the opposite is true -- we own all three -- so
    // every row goes to Rust instead.
    function dispatch(action: int) {
        if (root.use-editor-view) {
            root.menu-action(action);
        } else if (action == 100) {
            editor.undo();
        } else if (action == 101) {
            editor.redo();
        } else if (action == 102) {
            editor.cut();
        } else if (action == 103) {
            editor.copy();
        } else if (action == 104) {
            editor.paste();
        } else if (action == 105) {
            editor.select-all();
        } else {
            root.menu-action(action);
        }
        root.focus-editor();
    }

    // Shortcuts live in a FocusScope that *wraps* the content, because key
    // bindings are matched during the capture phase -- from the Window down
    // toward the focused element. A FocusScope beside the editor rather than
    // around it would never be on that path, and the focused TextInput would
    // swallow Ctrl+S before anything saw it.
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;

        KeyBinding {
            keys: @keys(Control + "n");
            activated => {
                root.new-document();
            }
        }
        KeyBinding {
            keys: @keys(Control + "o");
            activated => {
                root.open-document();
            }
        }
        KeyBinding {
            keys: @keys(Control + "s");
            activated => {
                root.save-document();
            }
        }
        KeyBinding {
            keys: @keys(Control + Shift + "s");
            activated => {
                root.save-as-document();
            }
        }
        KeyBinding {
            keys: @keys(Control + "w");
            activated => {
                root.close-active-tab();
            }
        }
        KeyBinding {
            keys: @keys(Control + "f");
            activated => {
                root.focus-find();
            }
        }

        // Duplicate Line / Move Line Up / Move Line Down (bp-ui/src/menus.rs
        // ids 95-97). Routed through `dispatch` like a menu click, which is
        // what it is -- the ids sit below 100, so they always reach Rust.
        // `run_line_edit` is what makes Move Line Up/Down and Duplicate Line
        // no-ops without the custom editor view, the same as the menu rows
        // being disabled there; claiming Alt+Up/Down here rather than only
        // when that view is active keeps this list state-free, like every
        // other binding in it.
        KeyBinding {
            keys: @keys(Control + "d");
            activated => {
                root.dispatch(95);
            }
        }
        KeyBinding {
            keys: @keys(Alt + UpArrow);
            activated => {
                root.dispatch(96);
            }
        }
        KeyBinding {
            keys: @keys(Alt + DownArrow);
            activated => {
                root.dispatch(97);
            }
        }
        KeyBinding {
            keys: @keys(Escape);
            activated => {
                root.find-open = false;
                root.focus-editor();
            }
        }

        VerticalLayout {
            // --- menu bar -----------------------------------------------
            Rectangle {
                height: 28px;
                background: Palette.panel;
                HorizontalLayout {
                    padding-left: 4px;
                    alignment: start;

                    file-label := MenuLabel {
                        label: "File";
                        clicked => {
                            file-menu.show();
                        }
                    }
                    edit-label := MenuLabel {
                        label: "Edit";
                        clicked => {
                            edit-menu.show();
                        }
                    }
                    view-label := MenuLabel {
                        label: "View";
                        clicked => {
                            view-menu.show();
                        }
                    }
                    insert-label := MenuLabel {
                        label: "Insert";
                        clicked => {
                            insert-menu.show();
                        }
                    }
                    format-label2 := MenuLabel {
                        label: "Format";
                        clicked => {
                            format-menu.show();
                        }
                    }
                    data-label := MenuLabel {
                        label: "Data";
                        clicked => {
                            data-menu.show();
                        }
                    }
                    note-label := MenuLabel {
                        label: "Note";
                        clicked => {
                            note-menu.show();
                        }
                    }
                    notebook-label := MenuLabel {
                        label: "Notebook";
                        clicked => {
                            notebook-menu.show();
                        }
                    }
                    organize-label := MenuLabel {
                        label: "Organize";
                        clicked => {
                            organize-menu.show();
                        }
                    }
                    research-label := MenuLabel {
                        label: "Research";
                        clicked => {
                            research-menu.show();
                        }
                    }
                    run-label := MenuLabel {
                        label: "Run";
                        clicked => {
                            run-menu.show();
                        }
                    }
                    security-label := MenuLabel {
                        label: "Security";
                        clicked => {
                            security-menu.show();
                        }
                    }
                    tools-label := MenuLabel {
                        label: "Tools";
                        clicked => {
                            tools-menu.show();
                        }
                    }
                    help-label := MenuLabel {
                        label: "Help";
                        clicked => {
                            help-menu.show();
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Palette.edge; }

            // --- tab strip ----------------------------------------------
            Rectangle {
                height: 32px;
                background: Palette.shell;
                HorizontalLayout {
                    padding-left: 6px;
                    spacing: 2px;
                    alignment: start;

                    for tab[i] in root.tabs: Tab {
                        label: tab.label;
                        dirty: tab.dirty;
                        active: tab.active;
                        selected => {
                            root.select-tab(tab.id);
                        }
                        closed => {
                            root.close-tab(tab.id);
                        }
                    }

                    MenuLabel {
                        label: "+";
                        clicked => {
                            root.new-document();
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Palette.edge; }

            // --- editor pane --------------------------------------------
            Rectangle {
                background: Palette.panel;
                vertical-stretch: 1;

                // Both exist rather than one being inside an `if`: an element
                // in an `if` is out of scope for `dispatch` and
                // `forward-focus`, which is the same constraint the find bar
                // is collapsed rather than conditional for.
                surface := EditorSurface {
                    visible: root.use-editor-view;
                    rows: root.editor-rows;
                    selection: root.editor-selection;
                    caret-row: root.caret-row;
                    caret-column: root.caret-column;
                    show-gutter: root.show-gutter;

                    key(text, control, shift, alt) => {
                        return root.editor-key(text, control, shift, alt);
                    }
                    pressed(row, column, extend) => {
                        root.editor-pressed(row, column, extend);
                    }
                    dragged(row, column) => {
                        root.editor-dragged(row, column);
                    }
                    scrolled(lines) => {
                        root.editor-scrolled(lines);
                    }
                    resized(rows) => {
                        root.editor-resized(rows);
                    }
                }

                Flickable {
                    visible: !root.use-editor-view;
                    viewport-height: max(self.height, editor-row.preferred-height);

                    editor-row := HorizontalLayout {
                        padding: 10px;
                        spacing: 10px;
                        alignment: start;

                        if root.show-gutter: Text {
                            text: root.gutter;
                            color: Palette.ink-dim;
                            font-family: "Consolas";
                            font-size: 14px;
                            horizontal-alignment: right;
                            width: 40px;
                        }

                        editor := TextInput {
                            text <=> root.doc-text;
                            color: Palette.ink;
                            selection-background-color: Palette.accent;
                            font-family: "Consolas";
                            font-size: 14px;
                            single-line: false;
                            wrap: root.wrap-text ? word-wrap : no-wrap;
                            horizontal-stretch: 1;
                            edited => {
                                root.text-edited(self.text);
                            }
                        }
                    }
                }
            }

            // --- find and replace ---------------------------------------
            // Collapsed rather than conditional: an element inside an `if` is
            // out of scope for `focus-find`, and Ctrl+F has to be able to put
            // the caret in the box it just opened.
            Rectangle {
                height: root.find-open ? 34px : 0px;
                visible: root.find-open;
                background: Palette.shell;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 8px;

                    Text {
                        text: "Find";
                        color: Palette.ink-dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 220px;
                        background: Palette.panel;
                        border-color: Palette.edge;
                        border-width: 1px;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            find-input := TextInput {
                                text <=> root.find-query;
                                color: Palette.ink;
                                selection-background-color: Palette.accent;
                                font-size: 13px;
                                single-line: true;
                                vertical-alignment: center;
                                edited => {
                                    root.find-changed();
                                }
                                accepted => {
                                    root.find-next();
                                }
                            }
                        }
                    }

                    MenuLabel {
                        label: "◂";
                        clicked => {
                            root.find-previous();
                        }
                    }
                    MenuLabel {
                        label: "▸";
                        clicked => {
                            root.find-next();
                        }
                    }

                    Text {
                        text: root.find-status;
                        color: Palette.ink-dim;
                        font-size: 12px;
                        vertical-alignment: center;
                        width: 110px;
                    }

                    Text {
                        text: "Replace";
                        color: Palette.ink-dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 200px;
                        background: Palette.panel;
                        border-color: Palette.edge;
                        border-width: 1px;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            TextInput {
                                text <=> root.replace-query;
                                color: Palette.ink;
                                selection-background-color: Palette.accent;
                                font-size: 13px;
                                single-line: true;
                                vertical-alignment: center;
                            }
                        }
                    }

                    MenuLabel {
                        label: "Replace All";
                        clicked => {
                            root.replace-all();
                        }
                    }

                    MenuLabel {
                        label: "In Folder...";
                        clicked => {
                            root.search-folder();
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    MenuLabel {
                        label: "×";
                        clicked => {
                            root.find-open = false;
                            root.focus-editor();
                        }
                    }
                }
            }

            // --- cross-file search results ------------------------------
            Rectangle {
                height: root.results-open ? 180px : 0px;
                visible: root.results-open;
                background: Palette.panel;

                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.results-summary;
                            color: Palette.ink-dim;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        MenuLabel {
                            label: "×";
                            clicked => {
                                root.results-open = false;
                            }
                        }
                    }

                    Flickable {
                        viewport-height: hits.preferred-height;

                        hits := VerticalLayout {
                            alignment: start;

                            for hit in root.search-hits: Rectangle {
                                height: 22px;
                                background: hit-area.has-hover ? Palette.edge : transparent;

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 10px;

                                    Text {
                                        text: hit.label;
                                        color: Palette.accent;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        width: 260px;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: hit.detail;
                                        color: Palette.ink-dim;
                                        font-family: "Consolas";
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }

                                hit-area := TouchArea {
                                    clicked => {
                                        root.open-hit(hit.index);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Palette.edge; }

            // --- status bar (specs.md section 3) ------------------------
            Rectangle {
                height: 44px;
                background: Palette.panel;

                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 2px;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        Text {
                            text: root.save-state;
                            // Dirty is the state worth noticing, so it gets
                            // the accent; a clean save is unremarkable.
                            color: root.is-dirty ? Palette.accent : Palette.ink-dim;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        StatusText { text: "│ " + root.format-label; }
                        StatusText { text: "│ " + root.encoding-label; }
                        StatusText { text: "│ " + root.line-ending-label; }
                        StatusText { text: "│ " + root.cursor-label; }

                        Rectangle {
                            width: theme-label.preferred-width + 16px;
                            background: theme-area.has-hover ? Palette.edge : transparent;
                            theme-label := Text {
                                text: "│ " + root.theme-name;
                                color: Palette.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                            theme-area := TouchArea {
                                clicked => {
                                    root.cycle-theme();
                                }
                            }
                        }
                    }

                    Text {
                        text: root.error-message == "" ? root.location : root.error-message;
                        color: root.error-message == "" ? Palette.ink-dim : Palette.accent;
                        font-size: 12px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Popups sit outside the layout so they can position freely. `x` tracks
    // the label plus the menu bar's 4px padding, which is the only horizontal
    // offset between the label's layout parent and the window.
    file-menu := MenuPopup {
        x: file-label.x + 4px;
        y: 28px;
        items: root.file-items;
        chosen(a) => {
            root.dispatch(a);
        }
    }
    edit-menu := MenuPopup {
        x: edit-label.x + 4px;
        y: 28px;
        items: root.edit-items;
        chosen(a) => {
            root.dispatch(a);
        }
    }
    view-menu := MenuPopup {
        x: view-label.x + 4px;
        y: 28px;
        items: root.view-items;
        chosen(a) => {
            root.dispatch(a);
        }
    }
    insert-menu := MenuPopup {
        x: insert-label.x + 4px;
        y: 28px;
        items: root.insert-items;
        chosen(a) => {
            root.dispatch(a);
        }
    }
    format-menu := MenuPopup {
        x: format-label2.x + 4px;
        y: 28px;
        items: root.format-items;
        chosen(a) => {
            root.dispatch(a);
        }
    }
    data-menu := MenuPopup {
        x: data-label.x + 4px;
        y: 28px;
        items: root.data-items;
        chosen(a) => {
            root.dispatch(a);
        }
    }
    note-menu := MenuPopup {
        x: note-label.x + 4px;
        y: 28px;
        items: root.note-items;
        chosen(a) => {
            root.dispatch(a);
        }
    }
    notebook-menu := MenuPopup {
        x: notebook-label.x + 4px;
        y: 28px;
        items: root.notebook-items;
        chosen(a) => {
            root.dispatch(a);
        }
    }
    organize-menu := MenuPopup {
        x: organize-label.x + 4px;
        y: 28px;
        items: root.organize-items;
        chosen(a) => {
            root.dispatch(a);
        }
    }
    research-menu := MenuPopup {
        x: research-label.x + 4px;
        y: 28px;
        items: root.research-items;
        chosen(a) => {
            root.dispatch(a);
        }
    }
    run-menu := MenuPopup {
        x: run-label.x + 4px;
        y: 28px;
        items: root.run-items;
        chosen(a) => {
            root.dispatch(a);
        }
    }
    security-menu := MenuPopup {
        x: security-label.x + 4px;
        y: 28px;
        items: root.security-items;
        chosen(a) => {
            root.dispatch(a);
        }
    }
    tools-menu := MenuPopup {
        x: tools-label.x + 4px;
        y: 28px;
        items: root.tools-items;
        chosen(a) => {
            root.dispatch(a);
        }
    }
    help-menu := MenuPopup {
        x: help-label.x + 4px;
        y: 28px;
        items: root.help-items;
        chosen(a) => {
            root.dispatch(a);
        }
    }
}
