/target
# Spike workspaces are standalone, so each has its own target directory that
# the root-anchored rule above does not cover.
spikes/**/target/
**/*.rs.bk
.env
.env.*
!.env.example
*.db
*.sqlite
*.sqlite3
*.log
/recovery
/history
/clipboard
/index
/embeddings
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
# Per-run local CI records. Benchmark results under artifacts/benchmarks/ are
# deliberately NOT ignored -- they are the evidence behind ADR-0015.
artifacts/test-evidence/*.json
