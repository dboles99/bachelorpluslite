{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BachelorPad+ Artifact Metadata",
  "type": "object",
  "required": [
    "artifact_id",
    "project",
    "task",
    "created_at",
    "path"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "step": {
      "type": [
        "string",
        "null"
      ]
    },
    "rosetta": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}